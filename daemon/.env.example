# Subrain_98 Daemon Environment Variables Example
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# Target Vault Directory (로컬 옵시디언 볼트 경로)
# 샘플 환경으로 즉시 테스트할 경우: "./samples/vault"
# 실제 옵시디언 볼트 연결 시: "/Users/your_username/Documents/ObsidianVault"
VAULT_DIR="./samples/vault"

# 헌법 파일 경로 (기본값: $VAULT_DIR/00_헌법.md)
CONSTITUTION_FILE="./samples/vault/00_헌법.md"
